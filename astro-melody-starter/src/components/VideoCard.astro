---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";

interface Props {
  video: CollectionEntry<"videos">;
}

const { video } = Astro.props;
const hasCover = video.data.cover && video.data.cover.length > 0;
---

<div
  class="relative h-[300px] shadow-xl rounded-xl overflow-hidden transition-transform duration-500 hover:-translate-y-1 hover:scale-105"
>
  <a href={`/videos/${video.data.series}/${video.id.split('/').pop()?.replace('.md', '')}/`}>
    {hasCover ? (
      <img 
        src={video.data.cover} 
        alt={video.data.title}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-purple-600 to-blue-600"></div>
    )}
    
    <!-- 播放图标覆盖层 -->
    <div class="absolute inset-0 flex items-center justify-center bg-black/20">
      <svg class="h-20 w-20 text-white/80 drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0 p-4 text-white bg-gradient-to-t from-black/70 to-transparent">
      <div class="flex items-center gap-1 text-xs mb-1">
        {
          video.data.tags?.map(tag => <span class="badge badge-outline bg-white/20 text-white border-white/30">{tag}</span>)
        } 
      </div>
      <p class="text-xs opacity-90"><FormattedDate date={new Date(video.data.pubDate)} /></p>
      <h3 class="card-title text-white text-lg">{video.data.title}</h3>
      <p class="text-xs opacity-75">{video.data.videoCount} 个视频</p>
    </div>
  </a>
</div>
