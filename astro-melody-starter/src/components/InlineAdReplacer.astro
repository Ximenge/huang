---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts?: CollectionEntry<"posts">[];
  skipFirst?: number;
}

const { posts = [], skipFirst = 3 } = Astro.props;

const postsData = posts.map(post => ({
  id: post.id,
  cover: post.data.cover,
  coverAlt: post.data.coverAlt,
  tags: post.data.tags,
  pubDate: post.data.pubDate,
  title: post.data.title
}));
---

<template id="inline-ad-template">
  <div class="inline-ad-card relative h-[300px] shadow-xl rounded-xl overflow-hidden transition-transform duration-500 hover:-translate-y-1 hover:scale-105 cursor-pointer" data-inline-ad="true">
    <div class="ad-layer absolute inset-0 z-0">
      <script is:inline async type="application/javascript" src="https://a.magsrv.com/ad-provider.js"></script>
      <ins class="eas6a97888e20" data-zoneid="5863494"></ins>
      <script is:inline>(AdProvider = window.AdProvider || []).push({"serve": {}});</script>
    </div>
    <div class="content-layer absolute inset-0 z-10 pointer-events-none">
      <figure class="h-full">
        <img class="ad-cover h-full w-full object-cover" src="" alt="" />
      </figure>
      <div class="absolute bottom-3 right-3 z-10 flex items-center gap-1 bg-black/50 backdrop-blur-sm rounded-full px-2 py-0.5 text-white text-xs pointer-events-none">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
        <span class="ad-view-count"></span>
      </div>
      <div class="absolute bottom-0 left-0 right-0 p-4 text-white bg-gradient-to-t from-black/70 to-transparent">
        <div class="ad-tags flex items-center gap-1 text-xs"></div>
        <p class="ad-date text-xs opacity-90"></p>
        <h3 class="ad-title card-title text-white"></h3>
      </div>
    </div>
  </div>
</template>

<script define:vars={{ postsData, skipFirst }}>
  function formatDate(date) {
    return new Date(date).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  }

  function shuffleArray(array) {
    var shuffled = array.slice();
    for (var i = shuffled.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var temp = shuffled[i];
      shuffled[i] = shuffled[j];
      shuffled[j] = temp;
    }
    return shuffled;
  }

  function getRandomPost(postsData) {
    var shuffled = shuffleArray(postsData);
    return shuffled[0];
  }

  function fillAdCard(card, post) {
    var cover = card.querySelector('.ad-cover');
    var tagsContainer = card.querySelector('.ad-tags');
    var dateEl = card.querySelector('.ad-date');
    var titleEl = card.querySelector('.ad-title');
    var viewCountEl = card.querySelector('.ad-view-count');

    if (cover) {
      cover.src = post.cover;
      cover.alt = post.coverAlt || post.title;
    }
    if (tagsContainer && post.tags) {
      tagsContainer.innerHTML = post.tags.map(function(tag) {
        return '<span class="badge badge-outline bg-white/20 text-white border-white/30">' + tag + '</span>';
      }).join('');
    }
    if (dateEl) {
      dateEl.textContent = formatDate(post.pubDate);
    }
    if (titleEl) {
      titleEl.textContent = post.title;
    }
    if (viewCountEl) {
      viewCountEl.textContent = Math.floor(Math.random() * 81) + 20;
    }
  }

  function restoreCard(wrapper, originalHTML) {
    wrapper.innerHTML = originalHTML;
    wrapper.removeAttribute('data-inline-ad');
    wrapper.style.cursor = '';
    if (typeof window.loadViewCounts === 'function') {
      window.loadViewCounts();
    }
  }

  function initInlineAd() {
    var template = document.getElementById('inline-ad-template');
    if (!template) return;

    var adHTML = template.innerHTML;

    var allCards = document.querySelectorAll('[data-view-count]');
    var cardWrappers = [];

    allCards.forEach(function(el) {
      var wrapper = el.closest('.relative.h-\\[300px\\]') || el.parentElement.parentElement;
      if (wrapper && !wrapper.hasAttribute('data-inline-ad') && !wrapper.closest('.ad-box') && !wrapper.closest('[data-ad-index]')) {
        cardWrappers.push(wrapper);
      }
    });

    if (cardWrappers.length <= skipFirst) return;

    var candidates = cardWrappers.slice(skipFirst);
    if (candidates.length === 0) return;

    var randomIndex = Math.floor(Math.random() * candidates.length);
    var targetCard = candidates[randomIndex];

    var originalHTML = targetCard.innerHTML;

    var fakePost = getRandomPost(postsData);

    targetCard.innerHTML = adHTML;
    targetCard.setAttribute('data-inline-ad', 'true');
    targetCard.style.cursor = 'pointer';

    var adCard = targetCard.querySelector('.inline-ad-card');
    if (adCard) {
      fillAdCard(adCard, fakePost);
    }

    targetCard.addEventListener('click', function handler() {
      restoreCard(targetCard, originalHTML);
      targetCard.removeEventListener('click', handler);
    }, { once: true });
  }

  document.addEventListener('DOMContentLoaded', initInlineAd);
  document.addEventListener('astro:page-load', initInlineAd);
</script>

<style>
  [data-inline-ad="true"] .ad-layer {
    width: 100% !important;
    height: 100% !important;
  }

  [data-inline-ad="true"] .ad-layer > ins.eas6a97888e20 {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
  }

  [data-inline-ad="true"] .eas6a97888e20 > div[id^="exo-native-widget-"] {
    width: 100% !important;
    height: 100% !important;
  }

  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-header {
    display: none !important;
  }

  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-outer-container {
    width: 100% !important;
    height: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-item-container {
    width: 100% !important;
    height: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-item {
    width: 100% !important;
    height: 100% !important;
  }

  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-item-image-wrapper,
  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-item-image,
  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-item-title,
  [data-inline-ad="true"] .eas6a97888e20 .exo-native-widget-item-text {
    display: none !important;
  }

  [data-inline-ad="true"] .content-layer {
    pointer-events: none !important;
  }
</style>
