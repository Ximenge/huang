---
// InArticleAd.astro - 文章内嵌原生广告（多位置）
// Zone ID: 5910390
// 广告位: 第1张图后、第2张图后、倒数第2张图前、最后一张图后
---

<div id="inArticleAd1" class="in-article-ad-hidden">
  <ins class="eas6a97888e2" data-zoneid="5910390"></ins>
</div>
<div id="inArticleAd2" class="in-article-ad-hidden">
  <ins class="eas6a97888e2" data-zoneid="5910390"></ins>
</div>
<div id="inArticleAd3" class="in-article-ad-hidden">
  <ins class="eas6a97888e2" data-zoneid="5910390"></ins>
</div>
<div id="inArticleAd4" class="in-article-ad-hidden">
  <ins class="eas6a97888e2" data-zoneid="5910390"></ins>
</div>

<script is:inline>
(function() {
  var inserted = false;

  function insertAds() {
    if (inserted) return true;

    var ad1 = document.getElementById('inArticleAd1');
    var ad2 = document.getElementById('inArticleAd2');
    var ad3 = document.getElementById('inArticleAd3');
    var ad4 = document.getElementById('inArticleAd4');
    if (!ad1 || !ad2 || !ad3 || !ad4) return false;

    var allP = document.querySelectorAll('article.prose p');
    var imgPs = [];
    for (var i = 0; i < allP.length; i++) {
      if (allP[i].querySelector('img')) {
        imgPs.push(allP[i]);
      }
    }

    var total = imgPs.length;
    if (total === 0) return false;

    var usedAfter = {};
    var toInsert = [];

    function tryAdd(afterIdx, adEl) {
      if (usedAfter[afterIdx]) return;
      usedAfter[afterIdx] = true;
      toInsert.push({ afterIndex: afterIdx, ad: adEl });
    }

    if (total >= 1) tryAdd(0, ad1);
    if (total >= 2) tryAdd(1, ad2);
    if (total >= 4) tryAdd(total - 3, ad3);
    if (total >= 3) tryAdd(total - 1, ad4);

    for (var j = 0; j < toInsert.length; j++) {
      var item = toInsert[j];
      imgPs[item.afterIndex].parentNode.insertBefore(item.ad, imgPs[item.afterIndex].nextSibling);
      item.ad.className = 'in-article-ad-visible';
    }

    if (toInsert.length > 0) {
      inserted = true;
      (AdProvider = window.AdProvider || []).push({"serve": {}});
    }

    return inserted;
  }

  function tryInsert() {
    var attempts = 0;
    var maxAttempts = 30;

    function attempt() {
      attempts++;
      var success = insertAds();
      if (!success && attempts < maxAttempts) {
        setTimeout(attempt, 300);
      }
    }

    attempt();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tryInsert);
  } else {
    tryInsert();
  }

  document.addEventListener('astro:page-load', function() {
    inserted = false;
    setTimeout(tryInsert, 500);
  });
})();
</script>

<style>
  .in-article-ad-hidden {
    display: none;
  }

  .in-article-ad-visible {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    max-height: 100px;
    overflow: hidden;
    margin: 20px auto;
    text-align: center;
    background: transparent;
    clear: both;
  }

  .in-article-ad-visible ins.eas6a97888e2 {
    display: block !important;
    width: 100% !important;
    background: transparent !important;
  }

  .in-article-ad-visible .exo-native-widget {
    width: 300px !important;
    height: 100px !important;
    margin: 0 auto !important;
  }

  @media (max-width: 640px) {
    .in-article-ad-visible {
      max-width: 100%;
      padding: 0 10px;
    }

    .in-article-ad-visible .exo-native-widget {
      width: 100% !important;
      height: auto !important;
    }
  }
</style>
