---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import PostComments from "@components/PostComments.astro";
import VideoPlayer from "@components/VideoPlayer.astro";
import { VIDEO_VAST_AD_ENABLED, VIDEO_VAST_AD_TAG } from "@consts";

export async function getStaticPaths() {
  const videos = await getCollection("videos");
  
  return videos.map((video) => {
    const slug = video.id.split('/').pop()?.replace('.md', '') || video.id;
    return {
      params: { 
        series: video.data.series, 
        slug: slug 
      },
      props: {
        video: video,
      },
    };
  });
}

const { series, slug } = Astro.params;
const { video } = Astro.props;
const { Content } = await render(video);

const { title, description, pubDate, category, tags, videoCount, videos } = video.data;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const videoURLs = videos.map(v => v.hlsUrl);
const firstVideoURL = videoURLs[0] || "";
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": title,
    "description": description,
    "uploadDate": pubDate,
    "contentUrl": firstVideoURL,
    "embedUrl": firstVideoURL,
    "author": {
      "@type": "Organization",
      "name": "91图图",
      "url": Astro.site
    },
    "publisher": {
      "@type": "Organization",
      "name": "91图图",
      "url": Astro.site
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL.toString()
    },
    "keywords": tags ? tags.join(", ") : ""
  })}></script>
  <main>
    <article class="prose mx-auto dark:prose-invert">
      <div class="mb-4">
        <a href={`/videos/${series}/`} class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 text-sm">
          <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          返回 {series}
        </a>
      </div>
      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 md:text-4xl">{title}</h1>
      </div>
      
      <div class="space-y-8">
        {videos.map((videoItem, index) => (
          <div class="bg-white dark:bg-neutral-900 rounded-xl shadow-sm border border-neutral-200 dark:border-neutral-700 p-6 not-prose">
            <VideoPlayer videoId={`video-player-${index}`} hlsUrl={videoItem.hlsUrl} />
          </div>
        ))}
      </div>
      
      <div class="text-neutral-700 dark:text-neutral-300 mt-8 leading-relaxed">
        <Content />
      </div>
      
      <div class="flex gap-2 prose-a:no-underline mt-8">
        {
          tags.map((tag) => (
            <span class="badge badge-outline badge-md">
              <a href={`/tags/${tag}/1/`}>{tag}</a>
            </span>
          ))
        }
      </div>
      
      <div class="mt-4 flex justify-between">
        <small>
          发布于 <FormattedDate date={new Date(pubDate)} />
        </small>
      </div>
    </article>

    <PostComments postId={`video-${video.id}`} />
  </main>

  <script is:inline define:vars={{ vastEnabled: VIDEO_VAST_AD_ENABLED, adTag: VIDEO_VAST_AD_TAG }}>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = cb;
        s.onerror = function() {
          console.warn('[VideoPlayer] Failed to load: ' + src);
          cb();
        };
        document.head.appendChild(s);
      }

      function parseVastNonLinear(xml) {
        try {
          var parser = new DOMParser();
          var doc = parser.parseFromString(xml, 'text/xml');
          var parseError = doc.querySelector('parsererror');
          if (parseError) {
            console.warn('[VideoPlayer] VAST XML parse error');
            return null;
          }
          var nonlinear = doc.querySelector('NonLinear');
          if (!nonlinear) {
            console.log('[VideoPlayer] No NonLinear element in VAST');
            return null;
          }
          var imgEl = nonlinear.querySelector('StaticResource');
          var iframeEl = nonlinear.querySelector('IFrameResource');
          var htmlEl = nonlinear.querySelector('HTMLResource');
          var clickEl = nonlinear.querySelector('NonLinearClickThrough');
          var width = nonlinear.getAttribute('width') || '300';
          var height = nonlinear.getAttribute('height') || '250';
          var imgSrc = '';
          var adType = '';
          if (imgEl) {
            imgSrc = imgEl.textContent.trim();
            adType = 'image';
          } else if (iframeEl) {
            imgSrc = iframeEl.textContent.trim();
            adType = 'iframe';
          } else if (htmlEl) {
            imgSrc = htmlEl.textContent.trim();
            adType = 'html';
          }
          if (!imgSrc) return null;
          var clickUrl = clickEl ? clickEl.textContent.trim() : '';
          var impressionEls = doc.querySelectorAll('Impression');
          var impressions = [];
          impressionEls.forEach(function(el) {
            var url = el.textContent.trim();
            if (url) impressions.push(url);
          });
          return { imgSrc: imgSrc, clickUrl: clickUrl, width: width, height: height, impressions: impressions, adType: adType };
        } catch (e) {
          console.warn('[VideoPlayer] VAST parse error:', e);
          return null;
        }
      }

      function fireImpression(url) {
        if (!url) return;
        try {
          fetch(url, { mode: 'no-cors', cache: 'no-store' }).catch(function() {});
        } catch (e) {}
      }

      function createAdOverlay(playerEl, adData) {
        var overlay = document.createElement('div');
        overlay.className = 'video-ad-overlay';

        var link = document.createElement('a');
        link.className = 'video-ad-link';
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        if (adData.clickUrl) link.href = adData.clickUrl;

        if (adData.adType === 'iframe') {
          var iframe = document.createElement('iframe');
          iframe.src = adData.imgSrc;
          iframe.width = adData.width;
          iframe.height = adData.height;
          iframe.frameBorder = '0';
          iframe.scrolling = 'no';
          iframe.style.cssText = 'border-radius:4px;display:block;';
          link.appendChild(iframe);
        } else if (adData.adType === 'html') {
          var div = document.createElement('div');
          div.style.cssText = 'width:' + adData.width + 'px;height:' + adData.height + 'px;overflow:hidden;border-radius:4px;';
          div.innerHTML = adData.imgSrc;
          link.appendChild(div);
        } else {
          var img = document.createElement('img');
          img.className = 'video-ad-img';
          img.src = adData.imgSrc;
          img.alt = '广告';
          img.style.maxWidth = adData.width + 'px';
          img.style.maxHeight = adData.height + 'px';
          link.appendChild(img);
        }

        var closeBtn = document.createElement('button');
        closeBtn.className = 'video-ad-close';
        closeBtn.title = '关闭广告';
        closeBtn.textContent = '×';
        closeBtn.onclick = function(e) {
          e.stopPropagation();
          e.preventDefault();
          overlay.style.display = 'none';
        };

        overlay.appendChild(link);
        overlay.appendChild(closeBtn);
        playerEl.appendChild(overlay);

        adData.impressions.forEach(fireImpression);
        console.log('[VideoPlayer] Ad overlay created and appended');
      }

      function loadVastAd(playerEl) {
        if (!adTag) return;
        var proxyUrl = '/api/vast-proxy?url=' + encodeURIComponent(adTag);
        console.log('[VideoPlayer] Fetching VAST via proxy:', proxyUrl);
        fetch(proxyUrl, { cache: 'no-store' })
          .then(function(res) {
            console.log('[VideoPlayer] VAST proxy response status:', res.status);
            if (!res.ok) return '';
            return res.text();
          })
          .then(function(xml) {
            if (!xml) {
              console.warn('[VideoPlayer] Empty VAST response');
              return;
            }
            console.log('[VideoPlayer] VAST XML length:', xml.length);
            var adData = parseVastNonLinear(xml);
            if (adData && adData.imgSrc) {
              console.log('[VideoPlayer] NonLinear ad loaded, type:', adData.adType, 'src:', adData.imgSrc);
              createAdOverlay(playerEl, adData);
            } else {
              console.log('[VideoPlayer] No NonLinear ad available');
            }
          })
          .catch(function(e) {
            console.warn('[VideoPlayer] VAST proxy fetch error:', e);
          });
      }

      function fixLiveDuration(player) {
        player.on('loadedmetadata', function() {
          var duration = player.duration();
          if (duration === Infinity || isNaN(duration)) {
            var tech = player.tech({ IWillNotUseThisInPlugins: true });
            if (tech && tech.vhs) {
              var segs = tech.vhs.playlists && tech.vhs.playlists.media_ ? tech.vhs.playlists.media_.segments : null;
              if (segs && segs.length > 0) {
                var total = 0;
                segs.forEach(function(seg) {
                  if (seg.duration) total += seg.duration;
                });
                if (total > 0) {
                  player.duration(total);
                }
              }
            }
          }
        });
        player.on('progress', function() {
          var duration = player.duration();
          if (duration === Infinity || isNaN(duration)) {
            var buffered = player.buffered();
            if (buffered && buffered.length > 0) {
              var end = buffered.end(buffered.length - 1);
              if (end > 0 && isFinite(end)) {
                player.duration(end);
              }
            }
          }
        });
      }

      function initPlayers() {
        var videoEls = document.querySelectorAll('video.video-js');
        if (!videoEls.length || typeof videojs === 'undefined') {
          console.warn('[VideoPlayer] No video elements or videojs not loaded');
          return;
        }

        videoEls.forEach(function(el) {
          if (el.dataset.vjsInit) return;
          el.dataset.vjsInit = '1';

          var hlsUrl = el.dataset.hlsUrl || '';
          if (!hlsUrl) return;

          var player = videojs(el, {
            controls: true,
            autoplay: false,
            preload: 'metadata',
            fluid: true,
            responsive: true,
            html5: {
              vhs: {
                overrideNative: true,
                enableLowInitialPlaylist: true
              },
              nativeAudioTracks: false,
              nativeVideoTracks: false
            }
          });

          player.src({
            src: hlsUrl,
            type: 'application/x-mpegURL'
          });

          player.on('error', function() {
            var err = player.error();
            if (err) console.error('[VideoPlayer] Error:', err.code, err.message);
          });

          fixLiveDuration(player);

          if (vastEnabled && adTag) {
            player.on('ready', function() {
              var playerEl = el.closest('.video-player-wrapper');
              if (playerEl) {
                console.log('[VideoPlayer] Player ready, loading ad for', el.id);
                loadVastAd(playerEl);
              } else {
                console.warn('[VideoPlayer] No wrapper found for', el.id);
              }
            });
          }
        });
      }

      loadScript('https://vjs.zencdn.net/8.10.0/video.min.js', function() {
        console.log('[VideoPlayer] Video.js loaded');
        initPlayers();
      });
    })();
  </script>
</BaseLayout>
