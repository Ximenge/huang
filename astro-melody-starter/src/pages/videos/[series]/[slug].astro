---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import PostComments from "@components/PostComments.astro";
import VideoPlayer from "@components/VideoPlayer.astro";
import { VIDEO_VAST_AD_ENABLED } from "@consts";

export async function getStaticPaths() {
  const videos = await getCollection("videos");
  
  return videos.map((video) => {
    const slug = video.id.split('/').pop()?.replace('.md', '') || video.id;
    return {
      params: { 
        series: video.data.series, 
        slug: slug 
      },
      props: {
        video: video,
      },
    };
  });
}

const { series, slug } = Astro.params;
const { video } = Astro.props;
const { Content } = await render(video);

const { title, description, pubDate, category, tags, videoCount, videos } = video.data;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const videoURLs = videos.map(v => v.hlsUrl);
const firstVideoURL = videoURLs[0] || "";
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": title,
    "description": description,
    "uploadDate": pubDate,
    "contentUrl": firstVideoURL,
    "embedUrl": firstVideoURL,
    "author": {
      "@type": "Organization",
      "name": "91图图",
      "url": Astro.site
    },
    "publisher": {
      "@type": "Organization",
      "name": "91图图",
      "url": Astro.site
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL.toString()
    },
    "keywords": tags ? tags.join(", ") : ""
  })}></script>
  <main>
    <article class="prose mx-auto dark:prose-invert">
      <div class="mb-4">
        <a href={`/videos/${series}/`} class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 text-sm">
          <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          返回 {series}
        </a>
      </div>
      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 md:text-4xl">{title}</h1>
      </div>
      
      <div class="space-y-8">
        {videos.map((videoItem, index) => (
          <div class="bg-white dark:bg-neutral-900 rounded-xl shadow-sm border border-neutral-200 dark:border-neutral-700 p-6 not-prose">
            <VideoPlayer videoId={`video-player-${index}`} hlsUrl={videoItem.hlsUrl} />
          </div>
        ))}
      </div>
      
      <div class="text-neutral-700 dark:text-neutral-300 mt-8 leading-relaxed">
        <Content />
      </div>
      
      <div class="flex gap-2 prose-a:no-underline mt-8">
        {
          tags.map((tag) => (
            <span class="badge badge-outline badge-md">
              <a href={`/tags/${tag}/1/`}>{tag}</a>
            </span>
          ))
        }
      </div>
      
      <div class="mt-4 flex justify-between">
        <small>
          发布于 <FormattedDate date={new Date(pubDate)} />
        </small>
      </div>
    </article>

    <PostComments postId={`video-${video.id}`} />
  </main>

  <script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>
  {VIDEO_VAST_AD_ENABLED && <script src="https://imasdk.googleapis.com/js/sdkloader/ima3.js"></script>}
  {VIDEO_VAST_AD_ENABLED && <script src="https://cdn.jsdelivr.net/npm/videojs-ima@2.3.0/dist/videojs.ima.min.js"></script>}
  <link href="https://cdn.jsdelivr.net/npm/videojs-ima@2.3.0/dist/videojs.ima.min.css" rel="stylesheet" />
  <script is:inline define:vars={{ vastEnabled: VIDEO_VAST_AD_ENABLED }}>
    document.addEventListener('DOMContentLoaded', function() {
      var videoElements = document.querySelectorAll('video.video-js');
      
      videoElements.forEach(function(videoEl) {
        var hlsUrl = videoEl.dataset.hlsUrl;
        var isVastEnabled = videoEl.dataset.vastEnabled === 'true';
        var vastTag = videoEl.dataset.vastTag || '';

        var player = videojs(videoEl, {
          controls: true,
          autoplay: false,
          preload: 'metadata',
          fluid: true,
          responsive: true,
          html5: {
            vhs: {
              overrideNative: true,
              enableLowInitialPlaylist: true
            },
            nativeAudioTracks: false,
            nativeVideoTracks: false
          }
        });

        player.src({
          src: hlsUrl,
          type: 'application/x-mpegURL'
        });

        if (isVastEnabled && vastTag && typeof player.ima === 'function') {
          try {
            var imaOptions = {
              id: videoEl.id,
              adTagUrl: vastTag,
              adsRenderingSettings: {
                loadVideoTimeout: 8000,
                uiElements: 'countdown'
              },
              debug: false,
              prerollTimeout: 8000,
              postrollTimeout: 8000,
              vastLoadTimeout: 8000
            };
            player.ima(imaOptions);
          } catch (e) {
            console.warn('IMA initialization failed, playing without ads:', e);
          }
        }

        player.on('error', function() {
          var error = player.error();
          if (error) {
            console.error('Video.js error:', error.code, error.message);
          }
        });
      });
    });
  </script>
</BaseLayout>
