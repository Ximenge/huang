---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import PostComments from "@components/PostComments.astro";
import VideoPlayer from "@components/VideoPlayer.astro";
import { VIDEO_VAST_AD_ENABLED, VIDEO_VAST_AD_TAG } from "@consts";

export async function getStaticPaths() {
  const videos = await getCollection("videos");
  
  return videos.map((video) => {
    const slug = video.id.split('/').pop()?.replace('.md', '') || video.id;
    return {
      params: { 
        series: video.data.series, 
        slug: slug 
      },
      props: {
        video: video,
      },
    };
  });
}

const { series, slug } = Astro.params;
const { video } = Astro.props;
const { Content } = await render(video);

const { title, description, pubDate, category, tags, videoCount, videos } = video.data;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const videoURLs = videos.map(v => v.hlsUrl);
const firstVideoURL = videoURLs[0] || "";
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": title,
    "description": description,
    "uploadDate": pubDate,
    "contentUrl": firstVideoURL,
    "embedUrl": firstVideoURL,
    "author": {
      "@type": "Organization",
      "name": "91图图",
      "url": Astro.site
    },
    "publisher": {
      "@type": "Organization",
      "name": "91图图",
      "url": Astro.site
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL.toString()
    },
    "keywords": tags ? tags.join(", ") : ""
  })}></script>
  <main>
    <article class="prose mx-auto dark:prose-invert">
      <div class="mb-4">
        <a href={`/videos/${series}/`} class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 text-sm">
          <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          返回 {series}
        </a>
      </div>
      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 md:text-4xl">{title}</h1>
      </div>
      
      <div class="space-y-8">
        {videos.map((videoItem, index) => (
          <div class="bg-white dark:bg-neutral-900 rounded-xl shadow-sm border border-neutral-200 dark:border-neutral-700 p-6 not-prose">
            <VideoPlayer videoId={`video-player-${index}`} hlsUrl={videoItem.hlsUrl} />
          </div>
        ))}
      </div>
      
      <div class="text-neutral-700 dark:text-neutral-300 mt-8 leading-relaxed">
        <Content />
      </div>
      
      <div class="flex gap-2 prose-a:no-underline mt-8">
        {
          tags.map((tag) => (
            <span class="badge badge-outline badge-md">
              <a href={`/tags/${tag}/1/`}>{tag}</a>
            </span>
          ))
        }
      </div>
      
      <div class="mt-4 flex justify-between">
        <small>
          发布于 <FormattedDate date={new Date(pubDate)} />
        </small>
      </div>
    </article>

    <PostComments postId={`video-${video.id}`} />
  </main>

  <script is:inline define:vars={{ vastEnabled: VIDEO_VAST_AD_ENABLED, adTag: VIDEO_VAST_AD_TAG }}>
    (function() {
      function loadScript(src, cb) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = cb;
        s.onerror = function() {
          console.warn('[VideoPlayer] Failed to load: ' + src);
          cb();
        };
        document.head.appendChild(s);
      }

      function initPlayers() {
        var videoEls = document.querySelectorAll('video.video-js');
        if (!videoEls.length || typeof videojs === 'undefined') {
          console.warn('[VideoPlayer] No video elements or videojs not loaded');
          return;
        }

        videoEls.forEach(function(el) {
          if (el.dataset.vjsInit) return;
          el.dataset.vjsInit = '1';

          var hlsUrl = el.dataset.hlsUrl || '';
          if (!hlsUrl) {
            console.warn('[VideoPlayer] No HLS URL found for', el.id);
            return;
          }

          var player = videojs(el, {
            controls: true,
            autoplay: false,
            preload: 'metadata',
            fluid: true,
            responsive: true,
            html5: {
              vhs: {
                overrideNative: true,
                enableLowInitialPlaylist: true
              },
              nativeAudioTracks: false,
              nativeVideoTracks: false
            }
          });

          player.on('error', function() {
            var err = player.error();
            if (err) console.error('[VideoPlayer] Error:', err.code, err.message);
          });

          if (vastEnabled && adTag && typeof player.ima === 'function') {
            try {
              console.log('[VideoPlayer] Initializing IMA with tag:', adTag);
              player.ima({
                id: el.id,
                adTagUrl: adTag,
                debug: false,
                showCountdown: false,
                adLabel: '广告',
                adsRenderingSettings: {
                  restoreCustomPlaybackStateOnAdBreakComplete: true
                }
              });

              player.src({
                src: hlsUrl,
                type: 'application/x-mpegURL'
              });

              player.on('adserror', function() {
                console.warn('[VideoPlayer] Ad error, removing ad container');
                var adContainer = el.parentNode.querySelector('.ima-ad-container');
                if (adContainer) adContainer.style.display = 'none';
              });

              player.on('adtimeout', function() {
                console.warn('[VideoPlayer] Ad timeout, removing ad container');
                var adContainer = el.parentNode.querySelector('.ima-ad-container');
                if (adContainer) adContainer.style.display = 'none';
              });

              console.log('[VideoPlayer] IMA initialized for', el.id);
            } catch (e) {
              console.warn('[VideoPlayer] IMA init failed, playing without ads:', e);
              player.src({
                src: hlsUrl,
                type: 'application/x-mpegURL'
              });
            }
          } else {
            if (vastEnabled) {
              console.warn('[VideoPlayer] VAST enabled but IMA plugin not available');
            }
            player.src({
              src: hlsUrl,
              type: 'application/x-mpegURL'
            });
          }
        });
      }

      loadScript('https://vjs.zencdn.net/8.10.0/video.min.js', function() {
        console.log('[VideoPlayer] Video.js loaded');
        if (vastEnabled && adTag) {
          loadScript('https://cdn.jsdelivr.net/npm/videojs-contrib-ads@7.5.2/dist/videojs-contrib-ads.min.js', function() {
            console.log('[VideoPlayer] contrib-ads loaded');
            loadScript('https://imasdk.googleapis.com/js/sdkloader/ima3.js', function() {
              console.log('[VideoPlayer] IMA SDK loaded');
              loadScript('https://cdn.jsdelivr.net/npm/videojs-ima@2.3.0/dist/videojs.ima.min.js', function() {
                console.log('[VideoPlayer] videojs-ima loaded');
                initPlayers();
              });
            });
          });
        } else {
          initPlayers();
        }
      });
    })();
  </script>

  <style is:global>
    .video-player-wrapper .ima-ad-container {
      z-index: 10;
    }
    .video-player-wrapper .ima-ad-container .ima-controls-div {
      display: flex !important;
    }
    .video-player-wrapper .ima-ad-container .ima-countdown-div {
      display: block !important;
    }
    .video-player-wrapper .bumpable-ima-ad-container {
      position: absolute !important;
      bottom: 40px !important;
      right: 10px !important;
      top: auto !important;
      left: auto !important;
      z-index: 10;
    }
    .video-player-wrapper .ima-nonlinear-ad {
      position: relative !important;
    }
    .video-player-wrapper .ima-ad-container > div:first-child {
      cursor: pointer;
    }
  </style>
</BaseLayout>
