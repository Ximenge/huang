---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";

export async function getStaticPaths() {
  const videos = await getCollection("videos");
  
  return videos.map((video) => {
    const slug = video.id.split('/').pop()?.replace('.md', '') || video.id;
    return {
      params: { 
        series: video.data.series, 
        slug: slug 
      },
      props: {
        video: video,
      },
    };
  });
}

const { series, slug } = Astro.params;
const { video } = Astro.props;
const { Content } = await render(video);

const { title, description, pubDate, category, tags, videoCount, videos } = video.data;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const videoURLs = videos.map(v => v.hlsUrl);
const firstVideoURL = videoURLs[0] || "";
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": title,
    "description": description,
    "uploadDate": pubDate,
    "contentUrl": firstVideoURL,
    "embedUrl": firstVideoURL,
    "author": {
      "@type": "Organization",
      "name": "Astro Melody",
      "url": Astro.site
    },
    "publisher": {
      "@type": "Organization",
      "name": "Astro Melody",
      "url": Astro.site
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalURL.toString()
    },
    "keywords": tags ? tags.join(", ") : ""
  })}></script>
  <main>
    <article class="prose mx-auto dark:prose-invert">
      <div class="mb-4">
        <a href={`/videos/${series}/`} class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 text-sm">
          <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          返回 {series}
        </a>
      </div>
      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 md:text-4xl">{title}</h1>
      </div>
      
      <div class="space-y-8">
        {
          videos.map((videoItem, index) => (
            <div class="bg-white dark:bg-neutral-900 rounded-xl shadow-sm border border-neutral-200 dark:border-neutral-700 p-6 not-prose">
              <div class="relative bg-neutral-100 dark:bg-neutral-800 rounded-lg overflow-hidden flex items-center justify-center p-4">
                <video 
                  id={`video-player-${index}`}
                  class="w-full max-w-3xl mx-auto rounded"
                  controls
                  preload="metadata"
                  playsinline
                  data-hls-url={videoItem.hlsUrl}
                >
                  您的浏览器不支持视频播放
                </video>
                
                <div id={`loading-indicator-${index}`} class="absolute inset-0 flex items-center justify-center bg-neutral-100 dark:bg-neutral-800">
                  <div class="text-center">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
                    <p class="text-neutral-600 dark:text-neutral-400">加载中...</p>
                  </div>
                </div>
                
                <div id={`error-indicator-${index}`} class="absolute inset-0 flex items-center justify-center bg-neutral-100 dark:bg-neutral-800 hidden">
                  <div class="text-center">
                    <svg class="h-16 w-16 mx-auto text-red-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <p class="text-neutral-600 dark:text-neutral-400">视频加载失败</p>
                    <p class="text-sm text-neutral-500 dark:text-neutral-500 mt-2">请稍后重试</p>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      
      <div class="text-neutral-700 dark:text-neutral-300 mt-8 leading-relaxed">
        <Content />
      </div>
      
      <div class="flex gap-2 prose-a:no-underline mt-8">
        {
          tags.map((tag) => (
            <span class="badge badge-outline badge-md">
              <a href={`/tags/${tag}/1/`}>{tag}</a>
            </span>
          ))
        }
      </div>
      
      <div class="mt-4 flex justify-between">
        <small>
          发布于 <FormattedDate date={new Date(pubDate)} />
        </small>
      </div>
    </article>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM loaded, initializing video players...');
      const videos = document.querySelectorAll('video[id^="video-player-"]');
      console.log(`Found ${videos.length} video players`);
      
      videos.forEach(function(video, index) {
        const loadingIndicator = document.getElementById(`loading-indicator-${index}`);
        const errorIndicator = document.getElementById(`error-indicator-${index}`);
        const hlsUrl = video.dataset.hlsUrl;
        
        console.log(`Initializing video ${index} with URL: ${hlsUrl}`);
        
        if (video && loadingIndicator && errorIndicator) {
          console.log('HLS.js available:', !!window.Hls);
          console.log('Native HLS support:', video.canPlayType('application/vnd.apple.mpegurl'));
          
          if (window.Hls) {
            try {
              const hls = new window.Hls({
                debug: true,
                enableWorker: true,
                lowLatencyMode: true,
                backBufferLength: 90,
                xhrSetup: function(xhr, url) {
                  xhr.withCredentials = false;
                }
              });

              console.log('HLS instance created');

              hls.loadSource(hlsUrl);
              hls.attachMedia(video);

              hls.on(window.Hls.Events.MANIFEST_PARSED, function() {
                console.log('Manifest parsed successfully');
                loadingIndicator.classList.add('hidden');
              });

              hls.on(window.Hls.Events.ERROR, function(event, data) {
                console.error('HLS error:', event, data);
                if (data.fatal) {
                  loadingIndicator.classList.add('hidden');
                  errorIndicator.classList.remove('hidden');
                  
                  switch (data.type) {
                    case window.Hls.ErrorTypes.NETWORK_ERROR:
                      console.error('Network error:', data);
                      hls.startLoad();
                      break;
                    case window.Hls.ErrorTypes.MEDIA_ERROR:
                      console.error('Media error:', data);
                      hls.recoverMediaError();
                      break;
                    default:
                      console.error('Fatal error:', data);
                      hls.destroy();
                      break;
                  }
                }
              });
            } catch (error) {
              console.error('Error creating HLS instance:', error);
              loadingIndicator.classList.add('hidden');
              errorIndicator.classList.remove('hidden');
            }
          } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
            console.log('Using native HLS support');
            video.src = hlsUrl;
            video.addEventListener('loadedmetadata', function() {
              console.log('Native HLS metadata loaded');
              loadingIndicator.classList.add('hidden');
            });
            video.addEventListener('error', function(e) {
              console.error('Native HLS error:', e);
              loadingIndicator.classList.add('hidden');
              errorIndicator.classList.remove('hidden');
            });
          } else {
            console.error('No HLS support');
            loadingIndicator.classList.add('hidden');
            errorIndicator.classList.remove('hidden');
          }
        } else {
          console.error('Missing video elements:', { video, loadingIndicator, errorIndicator });
        }
      });
    });
  </script>
</BaseLayout>
