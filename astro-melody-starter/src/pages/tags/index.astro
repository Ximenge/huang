---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Tags_TITLE, Tags_DESCRIPTION } from "@consts";

const allPosts = await getCollection("posts");
const allVideos = await getCollection("videos");
const allContent = [...allPosts, ...allVideos];

const tagMap: Record<string, {
  tag: string;
  count: number;
  lastDate: string;
  coverUrl: string;
  coverAlt: string;
}> = {};

allContent.forEach((item) => {
  (item.data.tags || []).forEach((tag) => {
    if (!tagMap[tag]) {
      tagMap[tag] = {
        tag,
        count: 0,
        lastDate: "",
        coverUrl: "",
        coverAlt: "",
      };
    }
    tagMap[tag].count += 1;
    const itemDate = new Date(item.data.pubDate).toISOString();
    if (itemDate > tagMap[tag].lastDate) {
      tagMap[tag].lastDate = itemDate;
      tagMap[tag].coverUrl = item.data.cover || "";
      tagMap[tag].coverAlt = item.data.coverAlt || tag;
    }
  });
});

const tagsData = Object.values(tagMap).sort(
  (a, b) => new Date(b.lastDate).getTime() - new Date(a.lastDate).getTime()
);

const tagsJson = JSON.stringify(tagsData);
---

<BaseLayout title={Tags_TITLE} description={Tags_DESCRIPTION}>
  <style is:inline>
    body { max-width: 100% !important; }
  </style>
  <div id="tags-grid-container" class="w-full px-3 sm:px-4 lg:px-6 xl:px-8">
    <div
      id="tags-grid"
      class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-2 sm:gap-3 lg:gap-4"
    >
    </div>
    <div id="scroll-sentinel" class="h-4 w-full"></div>
  </div>

  <script define:vars={{ tagsJson }}>
    var allTags = JSON.parse(tagsJson);
    var grid = document.getElementById("tags-grid");
    var sentinel = document.getElementById("scroll-sentinel");

    function estimatePerScreen() {
      var gridStyle = window.getComputedStyle(grid);
      var cols = gridStyle.getPropertyValue("grid-template-columns").split(" ").length;
      var cardHeight = 280;
      var available = window.innerHeight - 120;
      var rows = Math.ceil(available / (cardHeight + 16));
      return Math.max(rows * cols, cols * 2);
    }

    var perScreen = estimatePerScreen();
    var initialLoad = perScreen * 2;
    var loadPerPage = perScreen;
    var currentIndex = 0;

    function formatDate(isoStr) {
      var d = new Date(isoStr);
      var m = String(d.getMonth() + 1).padStart(2, "0");
      var day = String(d.getDate()).padStart(2, "0");
      return m + "-" + day;
    }

    function createTagCard(item, lazy) {
      var a = document.createElement("a");
      a.href = "/tags/" + encodeURIComponent(item.tag) + "/1/";
      a.className = "block group";

      var wrapper = document.createElement("div");
      wrapper.className = "relative overflow-hidden rounded-xl aspect-[3/4] bg-neutral-200 dark:bg-neutral-800";

      var img = document.createElement("img");
      img.src = item.coverUrl;
      img.alt = item.coverAlt;
      img.className = "w-full h-full object-cover transition-transform duration-500 group-hover:scale-110";
      if (lazy) img.loading = "lazy";
      img.onerror = function () {
        this.style.display = "none";
      };

      var overlay = document.createElement("div");
      overlay.className = "absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent pointer-events-none";

      var info = document.createElement("div");
      info.className = "absolute bottom-0 left-0 right-0 p-2.5 sm:p-3 text-white";

      var h3 = document.createElement("h3");
      h3.className = "font-bold text-base sm:text-lg truncate";
      h3.textContent = item.tag;

      var p = document.createElement("p");
      p.className = "text-[10px] sm:text-xs opacity-80 mt-0.5";
      p.textContent = item.count + "篇 · " + formatDate(item.lastDate);

      info.appendChild(h3);
      info.appendChild(p);
      wrapper.appendChild(img);
      wrapper.appendChild(overlay);
      wrapper.appendChild(info);
      a.appendChild(wrapper);

      return a;
    }

    function renderBatch(start, count) {
      var end = Math.min(start + count, allTags.length);
      for (var i = start; i < end; i++) {
        var lazy = i >= perScreen;
        grid.appendChild(createTagCard(allTags[i], lazy));
      }
      currentIndex = end;
    }

    renderBatch(0, initialLoad);

    var observer = new IntersectionObserver(
      function (entries) {
        if (entries[0].isIntersecting && currentIndex < allTags.length) {
          renderBatch(currentIndex, loadPerPage);
        }
      },
      { rootMargin: "200px" }
    );
    observer.observe(sentinel);

    var resizeTimer;
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        perScreen = estimatePerScreen();
        loadPerPage = perScreen;
      }, 300);
    });
  </script>
</BaseLayout>
